      "maximum": 65535
    },
    {
      "id": "rulesfile",
      "key": "RulesFile",
      "label": "机体规则文件",
      "type": "string",
      "default": "units.tsv",
      "file": "mod.ini",
      "section": "settings",
      "audience": "developer",
      "activation": "restart_required"
    }
  ]
