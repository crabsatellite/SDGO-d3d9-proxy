{
  "schema_version": 1,
  "id": "hangar_manager",
  "title": "机库整理与回收",
  "category": "gameplay",
  "hosts": [
    "client"
  ],
  "presentation": "configurable",
  "description": "在游戏的机体管理页整理机库、预览并确认兑换重复机体。此处只调整偏好。",
  "mechanism": "服务端事务排序和 GB 批量回收共用现有认证连接。GB 快速预览不逐台拉取详情，两次确认后服务器核对每个所选实例和奖励，统一完成原生拆解与 GB 入账。经验胶囊仍走原生逐台流程。服主安装或更新服务端一次，批量提交后重新登录查看结果；日常不需要 Manager 常驻。",
  "settings": [
    {
      "id": "keepcopies",
      "key": "KeepCopies",
      "label": "至少保留机体份数",
      "type": "integer",
      "default": 2,
      "file": "mod.ini",
      "section": "settings",
      "audience": "user",
      "activation": "restart_required",
      "minimum": 1,
      "maximum": 20
    },
    {
      "id": "sortafterexchange",
      "key": "SortAfterExchange",
      "label": "回收后整理机库",
      "type": "boolean",
      "default": true,
      "file": "mod.ini",
      "section": "settings",
      "audience": "user",
      "activation": "restart_required"
    },
    {
      "id": "requestintervalms",
      "key": "RequestIntervalMs",
      "label": "请求间隔（毫秒）",
      "type": "integer",
      "default": 150,
      "file": "mod.ini",
      "section": "settings",
      "audience": "developer",
      "activation": "restart_required",
      "minimum": 50,
      "maximum": 10000
    },
    {
      "id": "replytimeoutms",
      "key": "ReplyTimeoutMs",
      "label": "回应超时（毫秒）",
      "type": "integer",
      "default": 10000,
      "file": "mod.ini",
      "section": "settings",
      "audience": "developer",
      "activation": "restart_required",
      "minimum": 1000,
      "maximum": 60000
    },
    {
      "id": "maxslots",
      "key": "MaxSlots",
      "label": "机库读取上限",
