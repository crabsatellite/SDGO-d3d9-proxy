// Version resource, configured by CMake (sdgo_version_resource) for every DLL.
// tools\install_client.ps1 / install_server.ps1 recognise this project's loader DLLs by
// ProductName, so they never overwrite an unrelated d3d9.dll or winmm.dll.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @SDGO_VERSION_MAJOR@,@SDGO_VERSION_MINOR@,@SDGO_VERSION_PATCH@,0
PRODUCTVERSION  @SDGO_VERSION_MAJOR@,@SDGO_VERSION_MINOR@,@SDGO_VERSION_PATCH@,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "ProductName",      "SDGO mod framework"
            VALUE "ProductVersion",   "@SDGO_VERSION@"
            VALUE "FileVersion",      "@SDGO_VERSION@"
            VALUE "FileDescription",  "@RES_DESCRIPTION@"
            VALUE "OriginalFilename", "@RES_FILENAME@"
            VALUE "InternalName",     "@RES_FILENAME@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
