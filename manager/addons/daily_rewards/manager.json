    {
      "id": "endtime",
      "key": "EndTime",
      "label": "双倍结束时间",
      "type": "string",
      "default": "22:00",
      "file": "mod.ini",
      "section": "settings",
      "audience": "user",
      "activation": "restart_required",
      "pattern": "(?:[01][0-9]|2[0-3]):[0-5][0-9]"
    },
    {
      "id": "trace",
      "key": "Trace",
      "label": "诊断日志",
